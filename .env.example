# Supabase — use your REAL project values to load the live menu.
# If URL still contains "your-project", the app runs in DEMO mode from menu-catalog
# and will NOT reflect dashboard edits to sort order / descriptions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin API (for web admin panel and future iOS app)
ADMIN_API_KEY=change-me-to-a-secure-random-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Capacitor iPad admin shell (App Store) — baked at `npm run cap:sync` time.
# Staff never type a URL; defaults to `${NEXT_PUBLIC_APP_URL}/admin` or
# https://sushi-ro-ordering.vercel.app/admin when unset.
# CAPACITOR_SERVER_URL=https://sushi-ro-ordering.vercel.app/admin
